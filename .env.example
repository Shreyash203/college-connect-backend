# Backend environment variables
# For local development, place a .env file in Backend/ and do not commit it.
DATABASE_URL=mssql+pyodbc://<username>:<password>@<server>.database.windows.net/<database>?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
JWT_SECRET_KEY=replace-with-a-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTHORIZED_EMAIL_DOMAINS=iith.ac.in,gmail.com
EMAIL_PROVIDER=acs
EMAIL_FROM=your-email@yourdomain.com
ACS_EMAIL_CONNECTION_STRING=Endpoint=https://<RESOURCE_NAME>.communication.azure.com;AccessKey=replace-with-acs-access-key
ACS_EMAIL_ENDPOINT=https://<RESOURCE_NAME>.communication.azure.com
ACS_EMAIL_API_KEY=replace-with-acs-api-key
APP_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:4200
# Optional: use Azure Key Vault for production secret storage
AZURE_KEY_VAULT_NAME=<your-key-vault-name>